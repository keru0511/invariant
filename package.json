{
  "name": "invariant",
  "version": "0.0.1",
  "description": "Deterministic domain evaluation and natural-language domain model authoring",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:live": "vite-node --script scripts/live-evaluation.ts",
    "eval:live:smoke": "vite-node --script scripts/live-evaluation.ts --trials 1",
    "eval:live:large": "vite-node --script scripts/live-evaluation.ts --trials 10",
    "smoke:deployment": "node scripts/deployment-smoke.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "test:ci-gate": "node scripts/ci-gate-smoke.mjs",
    "hooks:install": "node scripts/hooks-install.mjs",
    "pr:create": "node scripts/pr-create.mjs"
  },
  "devDependencies": {
    "@mizchi/actrun": "0.32.0",
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.93.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.2"
  }
}
